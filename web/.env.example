# ---- Chain -----------------------------------------------------------------
# local | testnet | mainnet   (Monad mainnet is 143, testnet 10143, local Anvil 31337)
NEXT_PUBLIC_CHAIN=local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional. Payment detection subscribes over websocket and falls back to polling.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8545
# Optional. Envio GraphQL endpoint; when unset the ledger reads logs from the chain.
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_EXPLORER_URL=

# ---- Contracts -------------------------------------------------------------
# Verify the stablecoin address against the issuer before mainnet (architecture §13).
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_SYMBOL=USD
NEXT_PUBLIC_TOKEN_DECIMALS=6
NEXT_PUBLIC_REGISTRY_ADDRESS=

# ---- Treasury (server only) -----------------------------------------------
# Funds gas and nothing else. Never reuse this key anywhere.
TREASURY_PRIVATE_KEY=
DRIP_AMOUNT_MON=0.05
# Optional server-side RPC override (defaults to NEXT_PUBLIC_RPC_URL).
RPC_URL=
